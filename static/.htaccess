# museprep.com – Webserver-Einstellungen (Apache/LiteSpeed)
# Hinweis: Kommentare nur auf eigenen Zeilen, nie am Zeilenende.
# Kein php_flag/php_value: das erzeugt auf PHP-FPM-Hostern einen Fehler 500.

Options -Indexes -MultiViews -Includes -ExecCGI
DirectoryIndex index.html
AddDefaultCharset utf-8
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/rss+xml .xml
</IfModule>

# Auf dem Webspace läuft kein Code: Skript- und Konfigurationsdateien sperren.
<FilesMatch "(?i)\.(php\d?|phtml|phar|pht|cgi|fcgi|pl|py|rb|sh|shtml|asp|aspx|jsp|ini|log|sql|bak)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  # Keine fremden Quellen, kein JavaScript, keine Inline-Styles.
  Header always set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  # HSTS: nach erfolgreichem Go-Live auf max-age=31536000 erhöhen.
  Header always set Strict-Transport-Security "max-age=300"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  Header always set X-Frame-Options "DENY"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # Seiten und Feeds immer frisch prüfen.
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Dateien mit Prüfsumme im Namen ändern sich nie.
  <FilesMatch "(\.min\.[0-9a-f]{64}\.css|_hu_[0-9a-f]+\.(webp|png))$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# --- 301-Weiterleitungen der alten WordPress-Adressen (Paket 6) ---

# Seiten
RedirectMatch 301 ^/(?:start-here|about|free-downloads|entrance-exam-check)/?$ /en/
RedirectMatch 301 ^/deutsch-lernen/?$ /
RedirectMatch 301 ^/legal-policies/(?:privacy-policy-2|cookie-policy-eu)/?$ /en/datenschutz/
